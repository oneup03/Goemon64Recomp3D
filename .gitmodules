[submodule "lib/RmlUi"]
	path = lib/RmlUi
	url = https://github.com/mikke89/RmlUi/
[submodule "lib/rt64"]
	path = lib/rt64
	url = https://github.com/oneup03/rt64-3D.git
	branch = Goemon3D
[submodule "lib/freetype-windows-binaries"]
	path = lib/freetype-windows-binaries
	url = https://github.com/ubawurinna/freetype-windows-binaries
[submodule "lib/lunasvg"]
	path = lib/lunasvg
	url = https://github.com/sammycage/lunasvg
[submodule "lib/N64ModernRuntime"]
	path = lib/N64ModernRuntime
	# Upstream, pinned at cdf5abb: what rt64-3ds's runtime patch series (lib/rt64-3ds/nmr-patches)
	# is made against. The klorfmorf fork's changes are re-provided game-side in src/game/.
	url = https://github.com/N64Recomp/N64ModernRuntime
[submodule "Goemon64RecompSyms"]
	path = Goemon64RecompSyms
	url = https://github.com/klorfmorf/Goemon64RecompSyms
[submodule "lib/mnsg"]
	path = lib/mnsg
	url = https://github.com/klorfmorf/mnsg
[submodule "lib/SR-lib"]
	path = lib/SR-lib
	url = https://github.com/bo3b/SR-lib.git
	branch = api_expansion
[submodule "lib/rt64-3ds"]
	path = lib/rt64-3ds
	url = https://github.com/oneup03/rt64-3ds.git
