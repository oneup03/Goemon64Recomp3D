<template name="config-menu__stereo">
    <head>
    </head>
    <body>
        <form class="config__form">
            <div class="config__hz-wrapper">
                <div class="config__wrapper" data-event-mouseout="set_cur_config_index(-1)">
                    <div class="config-option" data-event-mouseover="set_cur_config_index(0)">
                        <label class="config-option__title">Stereoscopic 3D</label>
                        <div class="config-option__list">
                            <input type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(0)"
                                name="stereo_mode" data-checked="stereo_mode" value="0" id="stereo_off"
                                style="nav-up:#tab_stereo;nav-down:#stereo_separation_input"
                                data-attr-style="stereo_mode == '0' ? 'nav-up:#tab_stereo' : 'nav-up:#tab_stereo;nav-down:#stereo_separation_input'"
                            />
                            <label class="config-option__tab-label" for="stereo_off">Off</label>
                            <input type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(0)"
                                name="stereo_mode" data-checked="stereo_mode" value="1" id="stereo_sbs"
                                style="nav-up:#tab_stereo;nav-down:#stereo_separation_input"
                            />
                            <label class="config-option__tab-label" for="stereo_sbs">SbS</label>
                            <input type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(0)"
                                name="stereo_mode" data-checked="stereo_mode" value="2" id="stereo_tab"
                                style="nav-up:#tab_stereo;nav-down:#stereo_separation_input"
                            />
                            <label class="config-option__tab-label" for="stereo_tab">TaB</label>
                            <input type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(0)"
                                name="stereo_mode" data-checked="stereo_mode" value="3" id="stereo_row"
                                style="nav-up:#tab_stereo;nav-down:#stereo_separation_input"
                            />
                            <label class="config-option__tab-label" for="stereo_row">Row</label>
                            <input type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(0)"
                                name="stereo_mode" data-checked="stereo_mode" value="4" id="stereo_col"
                                style="nav-up:#tab_stereo;nav-down:#stereo_separation_input"
                            />
                            <label class="config-option__tab-label" for="stereo_col">Col</label>
                            <input type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(0)"
                                name="stereo_mode" data-checked="stereo_mode" value="5" id="stereo_checker"
                                style="nav-up:#tab_stereo;nav-down:#stereo_separation_input"
                            />
                            <label class="config-option__tab-label" for="stereo_checker">Check</label>
                            <input type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(0)"
                                name="stereo_mode" data-checked="stereo_mode" value="6" id="stereo_anaglyph"
                                style="nav-up:#tab_stereo;nav-down:#stereo_separation_input"
                            />
                            <label class="config-option__tab-label" for="stereo_anaglyph">Anaglyph</label>
                            <input type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(0)"
                                name="stereo_mode" data-checked="stereo_mode" value="7" id="stereo_leiasr"
                                style="nav-up:#tab_stereo;nav-down:#stereo_separation_input"
                            />
                            <label class="config-option__tab-label" for="stereo_leiasr">LeiaSR</label>
                        </div>
                    </div>

                    <div class="config-option" data-if="stereo_mode != '0'" data-event-mouseover="set_cur_config_index(1)">
                        <label class="config-option__title">Stereo Separation</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{stereo_separation}}</label>
                            <input
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(1)"
                                id="stereo_separation_input"
                                type="range"
                                min="0"
                                max="100"
                                style="flex:1;margin: 0dp;nav-up:#stereo_off;nav-down:#stereo_convergence_input;"
                                data-value="stereo_separation"
                            />
                        </div>
                    </div>

                    <div class="config-option" data-if="stereo_mode != '0'" data-event-mouseover="set_cur_config_index(2)">
                        <label class="config-option__title">Stereo Convergence</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{stereo_convergence}}</label>
                            <input
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(2)"
                                id="stereo_convergence_input"
                                type="range"
                                min="1"
                                max="100"
                                style="flex:1;margin: 0dp;nav-up:#stereo_separation_input;nav-down:#stereo_hud_depth_input;"
                                data-value="stereo_convergence"
                            />
                        </div>
                    </div>

                    <div class="config-option" data-if="stereo_mode != '0'" data-event-mouseover="set_cur_config_index(3)">
                        <label class="config-option__title">HUD Depth</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{stereo_hud_depth}}</label>
                            <input
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(3)"
                                id="stereo_hud_depth_input"
                                type="range"
                                min="0"
                                max="100"
                                style="flex:1;margin: 0dp;nav-up:#stereo_convergence_input;nav-down:#stereo_auto_off;"
                                data-value="stereo_hud_depth"
                            />
                        </div>
                    </div>

                    <div class="config-option" data-if="stereo_mode != '0'" data-event-mouseover="set_cur_config_index(4)">
                        <label class="config-option__title">Auto-Convergence</label>
                        <div class="config-option__list">
                            <input type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(4)"
                                name="stereo_auto" data-checked="stereo_auto_convergence" value="0" id="stereo_auto_off"
                                data-attr-style="stereo_auto_convergence == '1' ? 'nav-up:#stereo_hud_depth_input;nav-down:#stereo_auto_scale_input' : 'nav-up:#stereo_hud_depth_input'"
                            />
                            <label class="config-option__tab-label" for="stereo_auto_off">Off</label>
                            <input type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(4)"
                                name="stereo_auto" data-checked="stereo_auto_convergence" value="1" id="stereo_auto_on"
                                data-attr-style="stereo_auto_convergence == '1' ? 'nav-up:#stereo_hud_depth_input;nav-down:#stereo_auto_scale_input' : 'nav-up:#stereo_hud_depth_input'"
                            />
                            <label class="config-option__tab-label" for="stereo_auto_on">On</label>
                        </div>
                    </div>

                    <div class="config-option" data-if="stereo_mode != '0' &amp;&amp; stereo_auto_convergence == '1'" data-event-mouseover="set_cur_config_index(5)">
                        <label class="config-option__title">Auto-Convergence Scale</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{stereo_auto_convergence_scale}}%</label>
                            <input
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(5)"
                                id="stereo_auto_scale_input"
                                type="range"
                                min="0"
                                max="100"
                                style="flex:1;margin: 0dp;nav-up:#stereo_auto_off;"
                                data-value="stereo_auto_convergence_scale"
                            />
                        </div>
                    </div>
                </div>
                <div class="config__wrapper">
                    <p data-if="cur_config_index == 0">
                        Selects the stereoscopic 3D output mode.
                        <br /><br />
                        <b>Side-by-Side</b> / <b>Top-and-Bottom</b>: for VR headsets, AR glasses, and 3D TVs in those formats.
                        <br />
                        <b>Row / Column Interlaced</b> / <b>Checkerboard</b>: for 3D displays that interlace the two eyes spatially.
                        <br />
                        <b>Anaglyph</b>: for red/cyan glasses on any 2D display.
                        <br />
                        <b>LeiaSR</b>: autostereoscopic — requires a Leia/SR display and the SR Platform service installed (Windows D3D12 only).
                        <br /><br />
                        <b>Note:</b> Stereo 3D is incompatible with MSAA. Disable MSAA in the Graphics tab before enabling a stereo mode.
                    </p>
                    <p data-if="cur_config_index == 1">
                        Inter-eye separation (0..100). Higher values exaggerate the depth effect but may cause eye strain. Defaults to 50.
                    </p>
                    <p data-if="cur_config_index == 2">
                        Convergence distance (1..100). The depth at which objects sit on the screen plane. Objects closer pop out, objects farther push back. Defaults to 20.
                    </p>
                    <p data-if="cur_config_index == 3">
                        HUD depth (0..100). <b>50</b> places the HUD on the screen plane. Below 50 pushes the HUD behind the screen; above 50 makes it pop out toward you. Defaults to 35.
                    </p>
                    <p data-if="cur_config_index == 4">
                        When <b>On</b>, the game tells the renderer to reduce convergence in scenes where strong depth feels uncomfortable (FMVs, file select, minigames, first-person views).
                    </p>
                    <p data-if="cur_config_index == 5">
                        How much to scale convergence in auto-detected low-convergence scenes. <b>25%</b> means convergence is dropped to a quarter of the user-set value in those scenes.
                    </p>
                </div>
            </div>
        </form>
    </body>
</template>
